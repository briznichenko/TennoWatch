{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %@" : {
      "comment" : "A row of two lines of text. The first line shows the player's rank and the amount of experience points they have accumulated. The second line shows the number of items they need to obtain to reach the next rank.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %@:1 on bg" : {
      "comment" : "A label displaying the color code and contrast ratio of a color swatch. The first argument is the color code in hexadecimal format. The second argument is the string “%.1f”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@:1 on bg"
          }
        }
      }
    },
    "%@ / %@" : {
      "comment" : "A label showing the current XP and the XP needed for the next rank.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@, %lld" : {
      "comment" : "A subheading that displays the name of a counted item and its count. The first argument is the name of the counted item. The second argument is the count of the counted item.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$lld"
          }
        }
      }
    },
